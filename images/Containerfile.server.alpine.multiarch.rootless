FROM reg.devxy.io/docker.io/library/alpine:3.22

ARG DOCKER_IMAGE_CREATED="unknown"

LABEL org.label-schema.license="Apache-2.0" \
      org.label-schema.vcs-url="https://codeberg.org/crowci/crow" \
      org.label-schema.vendor="Crow CI" \
      org.opencontainers.image.created="${DOCKER_IMAGE_CREATED}" \
      org.opencontainers.image.description="Crow CI server (Alpine)" \
      io.artifacthub.package.readme-url="https://codeberg.org/crowci/crow/raw/branch/main/README.md" \
      maintainer="Crow Authors <admin@crowci.dev>"

ARG TARGETOS TARGETARCH

RUN apk add -U --no-cache ca-certificates tini logrotate su-exec && \
  addgroup -g 1000 -S crow && \
  adduser -u 1000 -G crow -S -s /bin/sh crow && \
  mkdir -p /var/lib/crow /var/log/crow /etc/cron.d && \
  ln -s /var/log/crow /var/lib/woodpecker && \
  chown -R crow:crow /var/log/crow /var/lib/woodpecker

ENV GODEBUG=netdns=go
# Internal setting do NOT change! Signals that crow is running inside a container
ENV WOODPECKER_IN_CONTAINER=true
ENV CROW_IN_CONTAINER=true
ENV XDG_CACHE_HOME=/var/lib/crow
ENV XDG_DATA_HOME=/var/lib/crow
EXPOSE 8000 9000 80 443

# Invalidate cache from this point forward when binary changes
ARG CACHE_BUST=unknown
RUN echo "Cache bust: ${CACHE_BUST}"

COPY dist/server/${TARGETOS}_${TARGETARCH}/crow-server /bin/
COPY images/scripts/crow-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/crow-entrypoint.sh

# Note: Entrypoint runs as root to set up cron, then switches to crow before exec'ing server
HEALTHCHECK CMD ["/bin/crow-server", "ping"]
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/crow-entrypoint.sh", "crow", "/bin/crow-server"]
