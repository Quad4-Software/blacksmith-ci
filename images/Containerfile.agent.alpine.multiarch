FROM --platform=$BUILDPLATFORM docker.io/golang:1.25-alpine3.22 AS build

WORKDIR /src
COPY . .
ARG TARGETOS TARGETARCH CI_COMMIT_SHA CI_COMMIT_TAG
ENV CI_COMMIT_SHA=$CI_COMMIT_SHA
ENV CI_COMMIT_TAG=$CI_COMMIT_TAG
ENV GOOS=$TARGETOS
ENV GOARCH=$TARGETARCH
RUN apk add --no-cache -q just git
RUN --mount=type=cache,target=/root/.cache/go-build \
  --mount=type=cache,target=/go/pkg \
  just build-agent

FROM docker.io/alpine:3.22

ARG CI_COMMIT_SHA CI_COMMIT_TAG

LABEL org.label-schema.license="Apache-2.0" \
      org.label-schema.vcs-url="https://codeberg.org/crowci/crow" \
      org.label-schema.vendor="Crow CI" \
      org.opencontainers.image.created="${DOCKER_IMAGE_CREATED}" \
      org.opencontainers.image.description="Crow CI agent (Alpine)" \
      io.artifacthub.package.readme-url="https://codeberg.org/crowci/crow/raw/branch/main/README.md" \
      maintainer="Crow Authors <admin@crowci.dev>"

RUN apk add -U --no-cache ca-certificates && \
  addgroup -g 1000 -S crow && \
  adduser -u 1000 -G crow -S crow && \
  mkdir -p /etc/crow /var/log/crow && \
  ln -s /etc/crow /etc/woodpecker && \
  chown -R crow:crow /etc/crow /etc/woodpecker /var/log/crow

ENV GODEBUG=netdns=go
# Internal setting do NOT change! Signals that crow is running inside a container
ENV WOODPECKER_IN_CONTAINER=true
ENV CROW_IN_CONTAINER=true
ENV CI_COMMIT_SHA=$CI_COMMIT_SHA
ENV CI_COMMIT_TAG=$CI_COMMIT_TAG
EXPOSE 3000

COPY --from=build /src/dist/crow-agent /bin/

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 CMD ["/bin/crow-agent", "ping"]
ENTRYPOINT ["/bin/crow-agent"]
