FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27-alpine AS build

WORKDIR /src
COPY . .

ARG TARGETOS TARGETARCH CI_COMMIT_SHA CI_COMMIT_TAG
ENV GOOS=$TARGETOS
ENV GOARCH=$TARGETARCH
RUN apk add --no-cache -q just git
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg \
    just build-cache-plugin

FROM docker.io/library/alpine:3.24

RUN apk add -U --no-cache ca-certificates

ENV GODEBUG=netdns=go

COPY --from=build /src/dist/crow-cache /bin/

# Runs as root on purpose: it restores files into a workspace whose other
# steps usually run as root, and must be able to replace what they wrote.
ENTRYPOINT ["/bin/crow-cache"]

ARG DOCKER_IMAGE_CREATED="unknown"
LABEL org.label-schema.license="Apache-2.0" \
      org.label-schema.vcs-url="https://codefloe.com/crowci/crow" \
      org.label-schema.vendor="Crow CI" \
      org.opencontainers.image.created="${DOCKER_IMAGE_CREATED}" \
      org.opencontainers.image.description="Crow CI build cache step (Alpine)" \
      io.artifacthub.package.readme-url="https://codefloe.com/crowci/crow/raw/branch/main/README.md" \
      maintainer="Crow Authors <admin@crowci.dev>"
