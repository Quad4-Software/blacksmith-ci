# escape=`

ARG WINDOWS_VERSION=ltsc2022
ARG GO_VERSION=1.27

FROM docker.io/library/golang:${GO_VERSION}-windowsservercore-${WINDOWS_VERSION} AS build

WORKDIR C:\src
ARG CI_COMMIT_SHA
ARG CI_COMMIT_TAG

COPY . .

SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]
RUN $version = $env:CI_COMMIT_TAG; `
    if (-not $version) { `
      $sha = $env:CI_COMMIT_SHA; `
      if (-not $sha) { $sha = 'unknown' } `
      $version = 'dev-' + $sha.Substring(0, [Math]::Min(10, $sha.Length)); `
    } `
    if ($version.StartsWith('v')) { $version = $version.Substring(1) } `
    $env:CGO_ENABLED = '0'; `
    go build -tags 'containers_image_openpgp exclude_graphdriver_btrfs exclude_graphdriver_devicemapper' -ldflags \"-s -w -X codefloe.com/crowci/crow/v6/version.Version=$version\" -o C:\out\crow-agent.exe codefloe.com/crowci/crow/v6/cmd/agent

FROM docker.io/library/golang:${GO_VERSION}-windowsservercore-${WINDOWS_VERSION}

ARG CI_COMMIT_SHA
ARG CI_COMMIT_TAG
ARG DOCKER_IMAGE_CREATED="unknown"

LABEL org.label-schema.license="Apache-2.0" `
      org.label-schema.vcs-url="https://codefloe.com/crowci/crow" `
      org.label-schema.vendor="Crow CI" `
      org.opencontainers.image.created="${DOCKER_IMAGE_CREATED}" `
      org.opencontainers.image.description="Crow CI agent (Windows LTSC 2022)" `
      io.artifacthub.package.readme-url="https://codefloe.com/crowci/crow/raw/branch/main/README.md" `
      maintainer="Crow Authors <admin@crowci.dev>"

ENV CROW_IN_CONTAINER=true
ENV WOODPECKER_IN_CONTAINER=true
ENV CI_COMMIT_SHA=${CI_COMMIT_SHA}
ENV CI_COMMIT_TAG=${CI_COMMIT_TAG}

SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]
RUN git --version

WORKDIR C:\crow
COPY --from=build C:\out\crow-agent.exe C:\crow\crow-agent.exe

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 CMD ["C:\\crow\\crow-agent.exe", "ping"]
ENTRYPOINT ["C:\\crow\\crow-agent.exe"]
