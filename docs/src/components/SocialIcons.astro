---
/**
 * Custom SocialIcons component that adds Liberapay donation link
 * alongside the default social icons.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro'
---

<Default {...Astro.props}><slot /></Default>

<a href="https://liberapay.com/crowci" rel="me" class="sl-flex donate-link">
  <svg
    aria-hidden="true"
    fill="currentColor"
    height="16"
    width="16"
    viewBox="0 0 24 24"
  >
    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
  </svg>
  <span class="donate-text">Donate</span>
</a>

<style>
  .donate-link {
    color: var(--sl-color-text-accent);
    padding: 0.5em;
    margin: -0.5em;
    gap: 0.35em;
    align-items: center;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .donate-link:hover {
    opacity: 0.66;
  }

  .donate-text {
    font-weight: 500;
  }
</style>
