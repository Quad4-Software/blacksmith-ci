      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (repo) (increase(crow_pipeline_count{repo=~\"$repo\", branch=~\"$branch\", pipeline=\"total\", status=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{repo}} success",
          "refId": "A"
        },
        {
          "expr": "sum by (repo) (increase(crow_pipeline_count{repo=~\"$repo\", branch=~\"$branch\", pipeline=\"total\", status=\"failure\"}[$__rate_interval]))",
          "legendFormat": "{{repo}} failure",
          "refId": "B"
