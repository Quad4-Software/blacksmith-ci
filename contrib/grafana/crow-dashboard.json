      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(crow_pipeline_duration_seconds_bucket{repo=~\"$repo\", branch=~\"$branch\"}[$__rate_interval])) by (le))",
