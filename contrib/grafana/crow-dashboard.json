      "id": 101,
      "title": "Pipeline Activity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto",
            "stacking": { "mode": "none" },
            "axisLabel": "pipelines/min"
          },
          "color": { "mode": "palette-classic" },
          "unit": "opm"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Pipeline Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(crow_pipeline_count{repo=~\"$repo\", branch=~\"$branch\", pipeline=\"total\", status=\"success\"}[$__rate_interval]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(crow_pipeline_count{repo=~\"$repo\", branch=~\"$branch\", pipeline=\"total\", status=\"failure\"}[$__rate_interval]))",
          "legendFormat": "failure",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "stacking": { "mode": "none" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "s"
