{
  "name": "crowci",
  "author": "Crow CI",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build --base=/BASE_PATH",
    "serve": "vite preview",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write --plugin prettier-plugin-tailwindcss --plugin @ianvs/prettier-plugin-sort-imports .",
    "format:check": "git -C .. diff --name-only --diff-filter=ACMR origin/main HEAD -- web/ | sed 's|^web/||' | xargs -r prettier --check --plugin prettier-plugin-tailwindcss --plugin @ianvs/prettier-plugin-sort-imports",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.17.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.3.0",
    "ansi_up": "^6.0.6",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "dompurify": "^3.4.7",
    "eslint-config-prettier": "^10.1.8",
    "fuse.js": "^7.4.0",
    "js-base64": "^3.7.8",
    "lodash": "^4.18.1",
    "marked": "^18.0.4",
    "node-emoji": "^2.2.0",
    "pinia": "^3.0.4",
    "postcss": "^8.5.15",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prismjs": "^1.30.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.8",
    "semver": "^7.8.1",
    "simple-icons": "^16.22.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "vue-draggable-plus": "^0.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.0",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.35",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-vue-scoped-css": "^3.1.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-prismjs": "^0.0.11",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.3"
  },
  "overrides": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "enhanced-resolve": "5.21.6"
  }
}
