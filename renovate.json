{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>crowci/renovate-config"],
  "baseBranchPatterns": ["$default", "/^v4\\.6\\.x$/"],
  "automergeType": "pr",
  "schedule": ["every 2 weeks on monday"],
  "updateNotScheduled": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/shared/constant/constant.go/"],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( registryUrl=(?<registryUrl>.*?))?( versioning=(?<versioning>.*?))?( extractVersion=(?<extractVersion>.*?))?\\s*\\n\\s*\\S+\\s*=\\s*\"[^:]+:(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "Justfile tool version variables with # renovate: comments",
      "customType": "regex",
      "managerFilePatterns": ["/Justfile/"],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?( extractVersion=(?<extractVersion>.*?))?\\s*\\n\\S+\\s*:=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "go install version pins in CI yaml files",
      "customType": "regex",
      "managerFilePatterns": ["/\\.crow/.+\\.yaml$/"],
      "matchStrings": ["go install (?<depName>[^@]+)@(?<currentValue>v[^\\s]+)"],
      "datasourceTemplate": "go"
    },
    {
      "description": "Tool versions with # renovate: datasource comments in CI yaml files",
      "customType": "regex",
      "managerFilePatterns": ["/\\.crow/.+\\.yaml$/"],
      "matchStrings": ["datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n.*?(?<currentValue>v\\d[^\\s]+)"],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "v4.5.x branch: only patch/security updates",
      "matchBaseBranches": ["v4.5.x"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "gin-swagger 1.x is not compatible with swaggo/files 2.x, see https://github.com/swaggo/gin-swagger/issues/264",
      "matchPackageNames": ["github.com/swaggo/files"],
      "allowedVersions": "<2.0.0"
    },
    {
      "groupName": "golang-lang",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^golang$/", "/xgo/"]
    },
    {
      "groupName": "golang-packages",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "frontend deps non-major",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["web/**"]
    },
    {
      "description": "Extract version from xgo container tags",
      "matchDatasources": ["docker"],
      "versioning": "regex:^go-(?<major>\\d+)\\.(?<minor>\\d+)\\.x$",
      "matchPackageNames": ["/techknowlogick/xgo/"]
    }
  ]
}
