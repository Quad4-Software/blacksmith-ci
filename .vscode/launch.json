{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Crow CI",
      "configurations": ["Crow UI", "Crow server", "Crow agent"],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Crow server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server/",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Crow agent",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/agent/",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "wait-for-server"
    },
    {
      "name": "Go: current file",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "program": "${file}"
    },
    {
      "name": "Crow UI",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["start"],
      "cwd": "${workspaceFolder}/web",
      "resolveSourceMapLocations": ["${workspaceFolder}/web/**", "!**/node_modules/**"],
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
