{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "direnv-export",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/direnv-to-env.sh",
      "options": {
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${env:PATH}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "direnv-then-wait-for-server",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/wait-for-server.sh",
      "options": {
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${env:PATH}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
