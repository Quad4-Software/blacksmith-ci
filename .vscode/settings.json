{
  "git.ignoreLimitWarning": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "vendor/": true
  },
  "go.lintTool": "golangci-lint",
  "go.lintFlags": ["--fast"],
  "go.buildTags": "test,integration",
  "go.testTags": "test,integration",
  "gopls": {
    "build.buildFlags": ["-tags=test,integration"],
    "build.env": {
      "GOFLAGS": "-tags=test,integration"
    },
    "build.tags": "test,integration"
  },
  "eslint.workingDirectories": ["./web"],
  "prettier.ignorePath": "./web/.prettierignore",
  // Auto fix
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  // CSS validation
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  // Tailwind CSS IntelliSense
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidConfigPath": "error",
  "tailwindCSS.lint.invalidScreen": "error",
  "tailwindCSS.lint.invalidTailwindDirective": "error",
  "tailwindCSS.lint.invalidVariant": "error",
  "tailwindCSS.lint.recommendedVariantOrder": "warning",
  // Associate Vue files with Tailwind
  "tailwindCSS.includeLanguages": {
    "vue": "html"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
