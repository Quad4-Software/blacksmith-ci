## openbao
export BAO_ADDR=https://openbao.devxy.io
# Ensure a valid token exists (triggers OIDC login if needed)
./scripts/ensure-bao-token.sh

_crowci_secrets=$(bao kv get -mount=development -format=json crowci | jq -r '.data.data')
export crowci_bot_token=$(echo "$_crowci_secrets" | jq -r '.crowci_bot_token')
export FORGEJO_TOKEN=$(echo "$_crowci_secrets" | jq -r '.forgejo_token')
export dockerhub_token=$(echo "$_crowci_secrets" | jq -r '.dockerhub_token')
export GITHUB_TOKEN=$(echo "$_crowci_secrets" | jq -r '.github_token')
export CROW_FORGEJO_CLIENT=$(echo "$_crowci_secrets" | jq -r '.crow_forgejo_client')
export CROW_FORGEJO_SECRET=$(echo "$_crowci_secrets" | jq -r '.crow_forgejo_secret')
export CROW_AGENT_SECRET=$(echo "$_crowci_secrets" | jq -r '.crow_agent_secret')
export CROW_TOKEN=$(echo "$_crowci_secrets" | jq -r '.crow_token')

## non-secret config
export CROW_OPEN=true
export CROW_ADMIN=pat-s

export CROW_HOST=http://localhost:8000

export CROW_FORGEJO=true
export CROW_FORGEJO_URL=https://ci.crowci.dev

# agent
export CROW_SERVER=localhost:9000
export CROW_MAX_WORKFLOWS=1

# enable if you want to develop the UI
export CROW_DEV_WWW_PROXY=http://localhost:8010

# if you want to test webhooks with an online forge like GitHub this address needs to be set and accessible from public server
export CROW_EXPERT_WEBHOOK_HOST=http://your-address.com

# disable health-checks while debugging (normally not needed while developing)
export CROW_HEALTHCHECK=false

export CROW_LOG_LEVEL=debug
# CROW_LOG_LEVEL=trace
